NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Tarja do que ainda não persiste (assinatura de plano e edição de perfil).
# O padrão, com a variável ausente, é MOSTRAR o aviso. Só ponha `false` quando
# essas duas telas passarem a gravar de verdade.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_ROOT_DOMAIN=jpproject.com.br

# WhatsApp COMERCIAL da plataforma — quem vende o SaaS, não a barbearia.
# É para onde vai o dono que quer contratar um plano superior. Só dígitos, com
# DDI. Sem isto, a tela de recurso bloqueado explica o plano mas não mostra
# botão de contato, em vez de abrir uma conversa que não existe.
NEXT_PUBLIC_PLATFORM_WHATSAPP=

# Emulador local (desenvolvimento). Exige `firebase emulators:start`.
NEXT_PUBLIC_USE_EMULATOR=false
