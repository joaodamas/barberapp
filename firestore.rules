rules_version = '2';

/**
 * Regras de segurança do Firestore — plataforma multi-barbearia.
 *
 * MODELO DE ISOLAMENTO: subcoleções sob /barbershops/{barbershopId}.
 * O isolamento é estrutural, não por filtro. Uma regra no nível do pai protege
 * tudo abaixo, e é impossível "esquecer o where" e vazar dado de outra
 * barbearia — que é exatamente o risco do modelo com coleções na raiz e campo
 * tenantId.
 *
 * MODELO DE ACESSO: o vínculo entre pessoa e barbearia vive no custom claim
 * `barbershops: { "<id>": "owner" | "staff" }`. Ler o claim é grátis; ler um
 * documento de membership dentro da regra custaria uma leitura por avaliação.
 * O cliente final NÃO tem claim: ele acessa o que é dele por `clientId`.
 *
 * Princípio: NEGAR POR PADRÃO. Cada épico que passar a persistir abre a SUA
 * coleção. O fallback do fim do arquivo nunca é relaxado.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------------ */
    /* Identidade e vínculo                                                */
    /* ------------------------------------------------------------------ */

    function isSignedIn() {
      return request.auth != null;
    }

    function memberships() {
      return isSignedIn() && 'barbershops' in request.auth.token
        ? request.auth.token.barbershops
        : {};
    }

    /** Papel da pessoa nesta barbearia, ou null se não tiver vínculo. */
    function roleIn(barbershopId) {
      return memberships().get(barbershopId, null);
    }

    function isOwnerOf(barbershopId) {
      return roleIn(barbershopId) == 'owner';
    }

    function isStaffOf(barbershopId) {
      return roleIn(barbershopId) in ['owner', 'staff'];
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Operador da plataforma — suporte e administração do SaaS. */
    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.platformAdmin == true;
    }

    /* ------------------------------------------------------------------ */
    /* Conta do cliente final — global, atravessa barbearias               */
    /* ------------------------------------------------------------------ */

    match /users/{userId} {
      allow read: if isSelf(userId) || isPlatformAdmin();

      /* `create` precisa da mesma guarda do `update`.
       *
       * Só o `update` filtrava os campos de autoridade, e `delete` é permitido:
       * dava para apagar o próprio documento e recriá-lo já com
       * `platformAdmin: true`. Nenhuma regra e nenhuma função leem esses campos
       * do documento hoje — a autoridade vem do custom claim, e é por isso que
       * não era explorável. Mas o `update` blindado passa a impressão de que o
       * campo é confiável, e no dia em que alguém escrever um painel de suporte
       * que leia `/users/{uid}.platformAdmin` a escalada fica pronta. */
      allow create: if isSelf(userId)
                    && !request.resource.data.keys()
                         .hasAny(['barbershops', 'platformAdmin']);
      // Ninguém edita o próprio vínculo nem o próprio papel por aqui.
      allow update: if isSelf(userId)
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['barbershops', 'platformAdmin']);
      allow delete: if isSelf(userId) || isPlatformAdmin();

      // Espelho de "de quais barbearias eu sou cliente" — escrito pelo servidor.
      match /memberships/{barbershopId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }
    }

    /* ------------------------------------------------------------------ */
    /* Conta de operação da plataforma — só o servidor                     */
    /* ------------------------------------------------------------------ */

    /* Índices do WhatsApp para o número ÚNICO da plataforma: id da mensagem →
     * barbearia, e telefone do cliente → última barbearia. São o mapa de volta
     * que o webhook usa quando o `phone_number_id` não identifica mais a dona.
     * Só o servidor escreve e lê — exposto, o segundo é uma lista de quem é
     * cliente de qual barbearia. */
    match /whatsapp_sent/{messageId} {
      allow read, write: if false;
    }
    match /whatsapp_conversations/{telefone} {
      allow read, write: if false;
    }

    match /whatsapp_numbers/{phoneNumberId} {
      /* Número da Cloud API → barbearia. O webhook é público e precisa desta
       * tradução para saber de quem é a mensagem que chegou; só o servidor
       * lê e escreve. Exposto, revelaria o mapa de quais barbearias usam a
       * plataforma e qual número é de quem. */
      allow read, write: if false;
    }

    match /platform_users/{userId} {
      /* Guarda o hash da senha provisória enquanto ela existe. Negado para
       * TODO MUNDO, inclusive o próprio dono e o suporte: só o Admin SDK
       * escreve e lê aqui, e ele não passa por regra. Declarado explicitamente
       * em vez de depender do fallback do fim do arquivo, porque um dia alguém
       * vai abrir uma coleção acima e este documento não pode vir junto. */
      allow read, write: if false;
    }

    /* ------------------------------------------------------------------ */
    /* A barbearia                                                         */
    /* ------------------------------------------------------------------ */

    match /barbershops/{barbershopId} {

      /* Ficha PÚBLICA. Nome, endereço, horário e marca precisam ser legíveis
       * sem login: é o que o servidor lê para pintar a página antes de saber
       * quem está acessando, e é informação de vitrine — a mesma que está na
       * fachada. Contrato e cobrança ficam na subcoleção `private`. */
      allow read: if true;
      // Criar e excluir barbearia é ato da plataforma, não do lojista.
      allow create, delete: if isPlatformAdmin();

      /* O dono edita a própria barbearia, menos o que define o contrato.
       *
       * `features` e `trial` entraram nesta lista porque são o contrato tanto
       * quanto `plan`: `features` é lido como gate de recurso e `trial` decide
       * quando o acesso vence. Sem eles aqui, o dono liberava o plano de cima e
       * empurrava o fim do teste para 2099 com uma escrita direta do navegador,
       * sem passar por função nenhuma. `createdBy` entrou junto, por sustentar
       * o limite de uma conta por barbearia. */
      allow update: if isPlatformAdmin()
                    || (isOwnerOf(barbershopId)
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['slug', 'plan', 'status',
                                                     'createdAt', 'createdBy',
                                                     'features', 'trial']));

      /* -------- contrato com a plataforma: nunca público -------- */

      match /private/{docId} {
        allow read: if isOwnerOf(barbershopId) || isPlatformAdmin();
        allow write: if isPlatformAdmin();
      }

      /* -------- quem trabalha aqui -------- */

      match /members/{userId} {
        allow read: if isStaffOf(barbershopId) || isSelf(userId);
        // Conceder acesso passa por Cloud Function: o claim precisa ser
        // gravado junto, senão o documento e o token divergem.
        allow write: if false;
      }

      /* -------- catálogo: cliente lê, dono escreve -------- */

      match /services/{serviceId} {
        allow read: if isSignedIn();
        allow write: if isOwnerOf(barbershopId);
      }

      /* -------- a equipe -------- */

      match /staff/{staffId} {
        /* Legível por quem está logado, como o catálogo: o CLIENTE precisa
         * ver os barbeiros para escolher com quem vai cortar. É vitrine —
         * nome e serviços que a pessoa atende, nada mais. Comissão fica em
         * `commissions`, que o cliente não alcança. */
        allow read: if isSignedIn();
        allow write: if isOwnerOf(barbershopId);
      }

      match /plans/{planId} {
        allow read: if isSignedIn();
        allow write: if isOwnerOf(barbershopId);
      }

      match /products/{productId} {
        allow read: if isSignedIn();
        allow write: if isOwnerOf(barbershopId);
      }

      /* -------- cliente da barbearia (G3) -------- */

      match /clients/{clientId} {
        /* Quem toca a barbearia lê a lista inteira — é a agenda de contatos
         * dela. O cliente lê SÓ o próprio cadastro, e o casamento é pelo id do
         * documento, porque `clients/{uid}` faz referência e identidade
         * coincidirem para quem tem conta.
         *
         * Cadastro de balcão tem id gerado: nenhum `request.auth.uid` o iguala,
         * então ele é visível apenas para a barbearia. É o desenho, não uma
         * lacuna — e o limite (o walk-in que criar conta não vê o histórico
         * antigo) está declarado em `functions/src/clients.ts`. */
        allow read: if isStaffOf(barbershopId)
                    || (isSignedIn() && clientId == request.auth.uid);

        /* Escrita é SÓ do servidor.
         *
         * O cadastro nasce dentro da transação que grava a reserva — os dois
         * juntos ou nenhum. Deixar o cliente criar aqui abriria dois buracos: um
         * cadastro fantasma sem atendimento nenhum, e a chance de gravar
         * `whatsapp` de outra pessoa e sequestrar a deduplicação dela.
         *
         * O dono edita pelo painel, que também passa por function — a tela nunca
         * escreve direto, pelo mesmo motivo de `bookings`. */
        allow write: if false;
      }

      /* -------- agenda -------- */

      match /bookings/{bookingId} {
        allow read: if isStaffOf(barbershopId)
                    || (isSignedIn() && resource.data.clientId == request.auth.uid);

        /* Criar reserva é SÓ pela Cloud Function `createBooking`.
         *
         * Esta regra permitia o cliente gravar direto, desde que não mexesse em
         * status e valor. Era o que existia antes de o servidor criar reservas —
         * e ficou aberta depois. Duas coisas passavam por ela:
         *
         * 1. Reserva sem `status`, que não bloqueia horário na checagem de
         *    conflito e mesmo assim aparece na agenda do dono.
         * 2. Criação em massa, sem passar pelo limite por cliente nem pela
         *    validação de dia, horário e antecedência.
         *
         * Nenhuma tela grava reserva direto: o app inteiro chama a função. */
        allow create: if false;

        // Cancelar e reagendar passam por Cloud Function: aplicam a política,
        // calculam o reembolso e registram a ocorrência.
        allow update, delete: if isStaffOf(barbershopId);
      }

      match /schedules/{scheduleId} {
        allow read: if isSignedIn();
        allow write: if isOwnerOf(barbershopId);
      }

      /* -------- financeiro: só quem é do time -------- */

      match /expenses/{expenseId}         { allow read, write: if isOwnerOf(barbershopId); }
      match /cash_entries/{entryId}       { allow read, write: if isOwnerOf(barbershopId); }
      /* Comissão é da PESSOA, não da equipe.
       *
       * A regra anterior era `isStaffOf`, ou seja: qualquer barbeiro lia a
       * comissão de todos os colegas. Com uma cadeira só isso nunca apareceu —
       * o único `staff` era o dono. Com equipe, é vazamento de salário entre
       * colegas, que é o tipo de coisa que destrói uma barbearia por dentro.
       *
       * O dono lê tudo, porque é ele quem paga. Cada barbeiro lê o que é dele.
       * O vínculo é por `uid` gravado no documento pelo servidor. */
      match /commissions/{commissionId} {
        allow read: if isOwnerOf(barbershopId)
                    || (isStaffOf(barbershopId) && resource.data.uid == request.auth.uid);
        allow write: if false;
      }
      match /inventory_movements/{moveId} { allow read, write: if isStaffOf(barbershopId); }

      /* -------- escrita exclusiva do servidor -------- */

      // Dinheiro, assinatura, fidelidade e auditoria só são gravados por Cloud
      // Functions (Admin SDK, que ignora estas regras). O cliente no máximo lê
      // o que é dele.
      function ownsResource() {
        return isSignedIn() && resource.data.clientId == request.auth.uid;
      }

      match /payments/{paymentId} {
        allow read: if isStaffOf(barbershopId) || ownsResource();
        allow write: if false;
      }
      match /refunds/{refundId} {
        allow read: if isStaffOf(barbershopId) || ownsResource();
        allow write: if false;
      }
      match /subscriptions/{subscriptionId} {
        allow read: if isStaffOf(barbershopId) || ownsResource();
        allow write: if false;
      }
      match /subscription_invoices/{invoiceId} {
        allow read: if isStaffOf(barbershopId) || ownsResource();
        allow write: if false;
      }
      match /loyalty_transactions/{txId} {
        allow read: if isStaffOf(barbershopId) || ownsResource();
        allow write: if false;
      }
      match /client_occurrences/{occurrenceId} {
        allow read: if isStaffOf(barbershopId);
        allow write: if false;
      }
      match /whatsapp_messages/{messageId} {
        allow read: if isOwnerOf(barbershopId);
        allow write: if false;
      }
      match /audit_log/{entryId} {
        // Log de auditoria é imutável, inclusive para o dono.
        allow read: if isOwnerOf(barbershopId) || isPlatformAdmin();
        allow write: if false;
      }

      /* -------- fallback dentro da barbearia -------- */

      // Coleção nova ainda não declarada acima fica inacessível, em vez de
      // herdar permissão por descuido.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    /* ------------------------------------------------------------------ */
    /* Índice público de barbearias — resolve o subdomínio para o tenant   */
    /* ------------------------------------------------------------------ */

    match /slugs/{slug} {
      // Precisa ser legível sem login: é o que traduz "osiqueira.dominio.com"
      // em um barbershopId antes de qualquer autenticação.
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    /* ------------------------------------------------------------------ */
    /* Fallback global                                                     */
    /* ------------------------------------------------------------------ */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
