rules_version = '2';

/**
 * Regras de segurança do Firestore — plataforma multi-barbearia.
 *
 * MODELO DE ISOLAMENTO: subcoleções sob /barbershops/{barbershopId}.
 * O isolamento é estrutural, não por filtro. Uma regra no nível do pai protege
 * tudo abaixo, e é impossível "esquecer o where" e vazar dado de outra
 * barbearia — que é exatamente o risco do modelo com coleções na raiz e campo
 * tenantId.
 *
 * MODELO DE ACESSO: o vínculo entre pessoa e barbearia vive no custom claim
 * `barbershops: { "<id>": "owner" | "staff" }`. Ler o claim é grátis; ler um
 * documento de membership dentro da regra custaria uma leitura por avaliação.
 * O cliente final NÃO tem claim: ele acessa o que é dele por `clientId`.
 *
 * Princípio: NEGAR POR PADRÃO. Cada épico que passar a persistir abre a SUA
 * coleção. O fallback do fim do arquivo nunca é relaxado.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------------ */
    /* Identidade e vínculo                                                */
    /* ------------------------------------------------------------------ */

    function isSignedIn() {
      return request.auth != null;
    }

    /* Senha provisória ainda não trocada: nenhum papel em barbearia nenhuma.
     *
     * A trava existia só na interface — quem tivesse a senha que viajou pelo
     * WhatsApp usava o SDK com acesso de dono completo, sem nunca trocá-la
     * (rodada E2E de 23/09). A troca é pela callable, que não passa por aqui. */
    function memberships() {
      return isSignedIn()
          && 'barbershops' in request.auth.token
          && request.auth.token.get('mustChangePassword', false) != true
        ? request.auth.token.barbershops
        : {};
    }

    /** Papel da pessoa nesta barbearia, ou null se não tiver vínculo. */
    function roleIn(barbershopId) {
      return memberships().get(barbershopId, null);
    }

    function isOwnerOf(barbershopId) {
      return roleIn(barbershopId) == 'owner';
    }

    function isStaffOf(barbershopId) {
      return roleIn(barbershopId) in ['owner', 'staff'];
    }

    /* A cadeira do barbeiro nesta barbearia (05/10), do claim `equipe` que o
     * convite grava. Só vale para quem é `staff` — o dono enxerga tudo por
     * `isOwnerOf`. */
    function meuStaffId(barbershopId) {
      return roleIn(barbershopId) == 'staff'
        ? request.auth.token.get('equipe', {}).get(barbershopId, null)
        : null;
    }

    /* A cadeira do claim AINDA é desta conta? (08/10)
     *
     * O claim diz qual cadeira a conta tinha quando o token foi emitido. Tirar
     * o acesso revoga a sessão, mas o token já emitido vale por até uma hora —
     * e nesse intervalo quem saiu seguia lendo a agenda e a lista de clientes
     * e fechando atendimento. A ficha (`staff.uid`) é a verdade de agora: a
     * revogação a zera antes de qualquer outra coisa.
     *
     * Custa UMA leitura por pedido do barbeiro (consulta inteira conta uma
     * vez), e só para quem é `staff`: dono e cliente não chegam aqui, porque
     * `meuStaffId` é nulo para eles e o `&&` para antes. */
    function souBarbeiroAtivo(barbershopId) {
      return meuStaffId(barbershopId) != null
        && get(/databases/$(database)/documents/barbershops/$(barbershopId)/staff/$(meuStaffId(barbershopId)))
             .data.get('uid', null) == request.auth.uid;
    }

    /* O barbeiro vê SÓ a própria agenda (decisão do dono, 05/10): nada dos
     * colegas nem do caixa da casa. */
    function ehDaMinhaCadeira(barbershopId, dados) {
      return meuStaffId(barbershopId) != null
        && dados.get('staffId', null) == meuStaffId(barbershopId)
        && souBarbeiroAtivo(barbershopId);
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Operador da plataforma — suporte e administração do SaaS. */
    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.platformAdmin == true;
    }

    /* ------------------------------------------------------------------ */
    /* Conta do cliente final — global, atravessa barbearias               */
    /* ------------------------------------------------------------------ */

    match /users/{userId} {
      allow read: if isSelf(userId) || isPlatformAdmin();

      /* `create` precisa da mesma guarda do `update`.
       *
       * Só o `update` filtrava os campos de autoridade, e `delete` é permitido:
       * dava para apagar o próprio documento e recriá-lo já com
       * `platformAdmin: true`. Nenhuma regra e nenhuma função leem esses campos
       * do documento hoje — a autoridade vem do custom claim, e é por isso que
       * não era explorável. Mas o `update` blindado passa a impressão de que o
       * campo é confiável, e no dia em que alguém escrever um painel de suporte
       * que leia `/users/{uid}.platformAdmin` a escalada fica pronta. */
      allow create: if isSelf(userId)
                    && !request.resource.data.keys()
                         .hasAny(['barbershops', 'platformAdmin']);
      // Ninguém edita o próprio vínculo nem o próprio papel por aqui.
      allow update: if isSelf(userId)
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['barbershops', 'platformAdmin']);
      allow delete: if isSelf(userId) || isPlatformAdmin();

      // Espelho de "de quais barbearias eu sou cliente" — escrito pelo servidor.
      match /memberships/{barbershopId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }
    }

    /* ------------------------------------------------------------------ */
    /* Conta de operação da plataforma — só o servidor                     */
    /* ------------------------------------------------------------------ */

    /* Índices do WhatsApp para o número ÚNICO da plataforma: id da mensagem →
     * barbearia, e telefone do cliente → última barbearia. São o mapa de volta
     * que o webhook usa quando o `phone_number_id` não identifica mais a dona.
     * Só o servidor escreve e lê — exposto, o segundo é uma lista de quem é
     * cliente de qual barbearia. */
    match /whatsapp_sent/{messageId} {
      allow read, write: if false;
    }
    match /whatsapp_conversations/{telefone} {
      allow read, write: if false;
    }

    match /whatsapp_numbers/{phoneNumberId} {
      /* Número da Cloud API → barbearia. O webhook é público e precisa desta
       * tradução para saber de quem é a mensagem que chegou; só o servidor
       * lê e escreve. Exposto, revelaria o mapa de quais barbearias usam a
       * plataforma e qual número é de quem. */
      allow read, write: if false;
    }

    /* Códigos de entrada de uso único (`functions/src/entrada.ts`): valem uma
     * sessão de dono. Só o Admin SDK toca aqui. */
    match /entradas/{codigo} {
      allow read, write: if false;
    }

    /* Contador de reservas criadas por conta por dia (`createBooking`,
     * auditoria de 28/09, M2). Só o servidor conta: legível, ensinaria ao
     * script quantas faltam; gravável, o cliente zeraria o próprio teto. */
    match /limites_de_reserva/{docId} {
      allow read, write: if false;
    }

    /* Integração com o JP Projects Hub (`functions/src/hub/`). A caixa de
     * saída dos avisos e a trilha dos comandos recebidos são do servidor:
     * gravável, o dono se passaria por outra barbearia no Hub ou marcaria
     * como já aplicado um comando de suspensão. Declaradas explicitamente,
     * pela mesma razão de `platform_users`. */
    match /plataforma_saida/{eventoId} {
      allow read, write: if false;
    }
    match /plataforma_eventos/{eventoId} {
      allow read, write: if false;
    }

    /* Avisos no Telegram (01/10): convite de uso único e o índice
     * conversa → barbearia. Só o servidor: gravável, alguém amarraria o
     * próprio Telegram à barbearia de outro e aprovaria encaixe lá. */
    /* Convites de barbeiro (05/10): o token é o segredo. Só o servidor. */
    match /convites_equipe/{token} {
      allow read, write: if false;
    }
    match /telegram_convites/{codigo} {
      allow read, write: if false;
    }
    match /telegram_chats/{chatId} {
      allow read, write: if false;
    }

    match /platform_users/{userId} {
      /* Guarda o hash da senha provisória enquanto ela existe. Negado para
       * TODO MUNDO, inclusive o próprio dono e o suporte: só o Admin SDK
       * escreve e lê aqui, e ele não passa por regra. Declarado explicitamente
       * em vez de depender do fallback do fim do arquivo, porque um dia alguém
       * vai abrir uma coleção acima e este documento não pode vir junto. */
      allow read, write: if false;
    }

    /* ------------------------------------------------------------------ */
    /* A barbearia                                                         */
    /* ------------------------------------------------------------------ */

    match /barbershops/{barbershopId} {

      /* Ficha PÚBLICA. Nome, endereço, horário e marca precisam ser legíveis
       * sem login: é o que o servidor lê para pintar a página antes de saber
       * quem está acessando, e é informação de vitrine — a mesma que está na
       * fachada. Contrato e cobrança ficam na subcoleção `private`. */
      allow get: if true;
      /* Ler UMA barbearia é vitrine; LISTAR todas não é. Com `read: if true`
       * qualquer pessoa, sem login, enumerava toda a base — inclusive quem
       * está suspenso por inadimplência (rodada E2E de 23/09). O servidor
       * resolve o tenant por `slugs/{slug}` → `get`, nunca por listagem. */
      allow list: if isPlatformAdmin();
      // Criar e excluir barbearia é ato da plataforma, não do lojista.
      allow create, delete: if isPlatformAdmin();

      /* O dono edita a própria barbearia, menos o que define o contrato.
       *
       * `features` e `trial` entraram nesta lista porque são o contrato tanto
       * quanto `plan`: `features` é lido como gate de recurso e `trial` decide
       * quando o acesso vence. Sem eles aqui, o dono liberava o plano de cima e
       * empurrava o fim do teste para 2099 com uma escrita direta do navegador,
       * sem passar por função nenhuma. `createdBy` entrou junto, por sustentar
       * o limite de uma conta por barbearia.
       *
       * O estado do ENCERRAMENTO também é do servidor (P0-5). Sem ele aqui, o
       * dono gravava `encerradaEmMs: 1` e o expurgo rodava na madrugada
       * seguinte, pulando os 30 dias que existem justamente para o clique
       * errado e a briga de sócios — ou gravava uma string e a conta nunca era
       * expurgada, quebrando a promessa da Política. `statusAntesDeEncerrar`
       * decide o que `reabrirConta` devolve; `expurgo` trava a reabertura; e
       * `suspended*` é escrito por `revisarAssinaturas`. Ver
       * `docs/LGPD-DIREITOS-DO-TITULAR.md` §3.4. */
      allow update: if isPlatformAdmin()
                    || (isOwnerOf(barbershopId)
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['slug', 'plan', 'status',
                                                     'createdAt', 'createdBy',
                                                     'features', 'trial',
                                                     'encerradaEm', 'encerradaEmMs',
                                                     'encerradaPor', 'encerramentoMotivo',
                                                     'statusAntesDeEncerrar', 'expurgo',
                                                     'suspendedAt', 'suspendedReason',
                                                     /* Liberação de recurso e
                                                      * decisão de plano também são
                                                      * contrato: sem eles aqui, o
                                                      * dono gravava `featuresExtras`
                                                      * e ligava Loja, Mensalistas e
                                                      * Financeiro avançado sem
                                                      * pagar (auditoria 28/09, M1). */
                                                     'featuresExtras', 'trialEncerradoEm',
                                                     'planoDefinidoEm', 'planoDefinidoMotivo',
                                                     /* `isento` impede a suspensão
                                                      * pelo Hub: gravável, qualquer
                                                      * dono se isentava de pagar.
                                                      * `dominio` é para onde o login
                                                      * da plataforma manda a equipe
                                                      * (`meusDestinos`): gravável,
                                                      * virava redirecionamento para
                                                      * qualquer site (29/09). */
                                                     'isento', 'dominio',
                                                     /* `locale` decide o fuso
                                                      * de todas as rotinas da
                                                      * loja; um fuso inválido
                                                      * gravado daqui derrubava
                                                      * a agenda das 7h. Nenhuma
                                                      * tela grava (08/10). */
                                                     'locale'])
                        && marcaDoDonoValida(barbershopId));

      /* A MARCA que o dono edita em "Sua marca" (02/10).
       *
       * `brand` inteiro era gravável pelo dono, e `brand.logo` vai para o
       * favicon, o manifest e o topo do app do cliente: sem conferência, ele
       * apontava o app para qualquer endereço. Agora só mudam estes campos, e
       * cada um com forma:
       *
       * - `name` (2–60) e `shortName` (1–14) — os limites de
       *   `lib/marca-editavel.ts`;
       * - `accentColor` — `#rrggbb`;
       * - `logo` — sai (volta o monograma) ou aponta para o `logo.png` de um
       *   envio DESTA barbearia no Storage (`lib/logo-da-marca.ts`);
       * - `logoHorizontal` e `icones` — o dono só os REMOVE: quem grava é a
       *   plataforma (o piloto tem pasta de ícones própria).
       *
       * `themeColor`, `panelLabel` e `clientTagline` ficam com a plataforma.
       * O cadastro grava a marca pela função (Admin SDK), que não passa aqui. */
      function marcaDoDonoValida(barbershopId) {
        let antes = resource.data.get('brand', {});
        let depois = request.resource.data.get('brand', {});
        let mudou = depois.diff(antes).affectedKeys();
        return mudou.hasOnly(['name', 'shortName', 'accentColor', 'logo', 'logoHorizontal', 'icones'])
          && (!('name' in mudou) || textoEntre(depois.get('name', null), 2, 60))
          && (!('shortName' in mudou) || textoEntre(depois.get('shortName', null), 1, 14))
          && (!('accentColor' in mudou)
              || (depois.get('accentColor', null) is string
                  && depois.accentColor.matches('^#[0-9a-fA-F]{6}$')))
          && (!('logo' in mudou) || !('logo' in depois) || logoDaBarbearia(depois.logo, barbershopId))
          && (!('logoHorizontal' in mudou) || !('logoHorizontal' in depois))
          && (!('icones' in mudou) || !('icones' in depois));
      }

      function textoEntre(v, minimo, maximo) {
        return v is string && v.trim().size() >= minimo && v.size() <= maximo;
      }

      /* O `logo.png` de um envio desta barbearia, no Storage oficial (ou no
       * emulador). Mesmo formato que `ehLogoDaBarbearia` confere no app. O id
       * da barbearia é alfanumérico, e por isso entra direto na expressão. */
      function logoDaBarbearia(url, barbershopId) {
        return url is string
          && url.matches('^(https://firebasestorage[.]googleapis[.]com|http://(127[.]0[.]0[.]1|localhost):9199)/v0/b/[a-z0-9._-]+/o/barbershops%2F'
                         + barbershopId + '%2Fbrand%2F[0-9]{10,16}%2Flogo[.]png[?]alt=media$');
      }

      /* -------- contrato com a plataforma: nunca público -------- */

      match /private/{docId} {
        allow read: if isOwnerOf(barbershopId) || isPlatformAdmin()
                    /* `financeiro` (28/09): taxas e comissão saíram da ficha
                     * pública. A equipe precisa delas para fechar atendimento
                     * — a mesma leitura que tinha antes, só que agora não é de
                     * qualquer um. */
                    || (docId == 'financeiro' && souBarbeiroAtivo(barbershopId));
        /* O dono edita taxas e comissão pela tela de Ajustes — e SÓ esses três
         * campos: o resto de `private/` é contrato e cobrança da plataforma. */
        allow write: if isPlatformAdmin()
                     || (docId == 'financeiro'
                         && isOwnerOf(barbershopId)
                         && request.resource.data.keys()
                              .hasOnly(['paymentFees', 'paymentForms', 'commissionSplit']));
      }

      /* -------- quem trabalha aqui -------- */

      match /members/{userId} {
        /* Quem trabalha aqui, com e-mail. O barbeiro lia a lista inteira — os
         * e-mails dos colegas e do dono — porque a regra é de quando o único
         * `staff` era o próprio dono (08/10). Agora: o dono lê todos; cada um,
         * o próprio. */
        allow read: if isOwnerOf(barbershopId) || isSelf(userId);
        // Conceder acesso passa por Cloud Function: o claim precisa ser
        // gravado junto, senão o documento e o token divergem.
        allow write: if false;
      }

      /* -------- catálogo: cliente lê, dono escreve -------- */

      /* Vitrine pública (decisão de 23/09): quem abre o link da barbearia
       * vê serviços, preços, barbeiros e planos ANTES de criar conta — o
       * login só é pedido para confirmar a reserva. É a mesma informação da
       * fachada; o que não é vitrine (remuneração, custo de produto) mora
       * fora destas coleções. */
      match /services/{serviceId} {
        allow read: if true;
        allow write: if isOwnerOf(barbershopId);
      }

      /* -------- a equipe -------- */

      match /staff/{staffId} {
        /* Vitrine: o cliente escolhe com quem vai cortar. Nome, serviços e
         * jornada — nada mais.
         *
         * O comentário anterior dizia que a comissão ficava em `commissions`,
         * e não era verdade: a tela de Equipe gravava `commissionPct` e
         * `salary` aqui, e qualquer conta logada lia o salário de todo barbeiro
         * de toda barbearia. A remuneração foi para `staff_pay`, e a ficha
         * pública não pode voltar a recebê-la. */
        allow read: if true;
        /* `uid` (a conta ligada à cadeira) e `convitePendente` são do SERVIDOR
         * (09/10): o aceite do convite grava o primeiro, a criação do convite o
         * segundo. O dono gravando `uid` ligava a ficha à conta de QUALQUER
         * pessoa cujo id ele soubesse — e revogar ou remover esse "barbeiro"
         * reescrevia os claims e derrubava a sessão de terceiro; zerar `uid`
         * antes de apagar contornava o "só o servidor remove ficha com conta".
         * Na criação, `uid` só pode ser nulo. */
        allow create: if isOwnerOf(barbershopId)
          && request.resource.data.get('uid', null) == null
          && !('convitePendente' in request.resource.data)
          && !request.resource.data.keys().hasAny(['commissionPct', 'salary']);
        /* Ficha antiga ainda tem os campos: editar o nome continua valendo, e
         * REMOVÊ-los também (é o que a tela faz ao salvar a remuneração).
         * Gravar ou alterar, não. */
        allow update: if isOwnerOf(barbershopId)
          && request.resource.data.get('uid', null) == resource.data.get('uid', null)
          && request.resource.data.get('convitePendente', null) == resource.data.get('convitePendente', null)
          && !request.resource.data.diff(resource.data).addedKeys().hasAny(['commissionPct', 'salary'])
          && !request.resource.data.diff(resource.data).changedKeys().hasAny(['commissionPct', 'salary']);
        /* Ficha com conta ligada (`uid`) só sai pelo servidor (08/10):
         * `removerBarbeiro` desfaz claim, `members`, aparelhos e Telegram antes
         * de apagar. Apagando direto, a conta seguia com o papel de barbeiro. */
        allow delete: if isOwnerOf(barbershopId)
          && resource.data.get('uid', null) == null;
      }

      match /staff_pay/{staffId} {
        allow read, write: if isOwnerOf(barbershopId);
      }

      match /plans/{planId} {
        allow read: if true;
        allow write: if isOwnerOf(barbershopId);
      }

      /* Produto é da loja, não da vitrine: `cost` é quanto o dono pagou, e o
       * app do cliente não lê produto nenhum.
       *
       * O barbeiro também não (08/10): a ficha traz o custo — o CMV da casa —
       * e o painel dele não vende produto. Quando vender, a tela pede ao
       * servidor só nome, preço e estoque, em vez de reabrir o custo. */
      match /products/{productId} {
        allow read: if isOwnerOf(barbershopId);

        /* O cadastro tem forma (10/10): preço e custo são número ≥ 0, nome é
         * texto curto. A venda CONGELA preço e custo no movimento, então editar o
         * cadastro nunca reescreve o passado — mas um valor negativo ou um
         * texto no lugar do número quebraria a próxima venda e o CMV. */
        function produtoValido(p) {
          return p.get('name', '') is string
            && p.get('name', '').size() > 0
            && p.get('name', '').size() <= 120
            && p.get('price', 0) is number
            && p.get('price', 0) >= 0
            && p.get('cost', 0) is number
            && p.get('cost', 0) >= 0
            && p.get('minStock', 0) is number
            && p.get('minStock', 0) >= 0
            && p.get('archived', false) is bool
            && comissaoDoProdutoValida(p);
        }

        /* A comissão do barbeiro NESTE produto (sobre o preço de venda):
         * ausente ou null = usa a regra de sempre; número de 0 a 100 = vale,
         * e 0 é "este produto não comissiona". Fora disso o servidor trataria
         * como ausente e o dono acharia que configurou. */
        function comissaoDoProdutoValida(p) {
          return p.get('commissionPct', null) == null
            || (p.get('commissionPct', null) is number
                && p.get('commissionPct', null) >= 0
                && p.get('commissionPct', null) <= 100);
        }

        allow create: if isOwnerOf(barbershopId)
          && produtoValido(request.resource.data)
          && request.resource.data.get('stock', 0) is number
          && request.resource.data.get('stock', 0) >= 0
          && request.resource.data.keys().hasOnly(['name', 'cost', 'price', 'stock', 'minStock', 'archived', 'commissionPct']);

        /* O SALDO (`stock`) é do servidor: entrada, venda, devolução e ajuste
         * gravam o movimento e o saldo na mesma transação. Editar o número
         * direto era a reposição "sem custo, sem data, sem registro" (D19). O
         * dono edita só o que é cadastro — e arquivar é uma flag, nunca um
         * delete: o produto tem vendas e CMV no histórico. */
        allow update: if isOwnerOf(barbershopId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'price', 'cost', 'minStock', 'archived', 'commissionPct'])
          && produtoValido(request.resource.data);

        allow delete: if isOwnerOf(barbershopId);
      }

      /* -------- cliente da barbearia (G3) -------- */

      match /clients/{clientId} {
        /* Quem toca a barbearia lê a lista inteira — é a agenda de contatos
         * dela. O cliente lê SÓ o próprio cadastro, e o casamento é pelo id do
         * documento, porque `clients/{uid}` faz referência e identidade
         * coincidirem para quem tem conta.
         *
         * Cadastro de balcão tem id gerado: nenhum `request.auth.uid` o iguala,
         * então ele é visível apenas para a barbearia. É o desenho, não uma
         * lacuna — e o limite (o walk-in que criar conta não vê o histórico
         * antigo) está declarado em `functions/src/clients.ts`. */
        /* O barbeiro com a cadeira AINDA ligada (08/10): com o claim só, quem
         * teve o acesso tirado seguia lendo nome e WhatsApp de todo cliente
         * até o token vencer. */
        allow read: if isOwnerOf(barbershopId)
                    || souBarbeiroAtivo(barbershopId)
                    || (isSignedIn() && clientId == request.auth.uid);

        /* Escrita é SÓ do servidor.
         *
         * O cadastro nasce dentro da transação que grava a reserva — os dois
         * juntos ou nenhum. Deixar o cliente criar aqui abriria dois buracos: um
         * cadastro fantasma sem atendimento nenhum, e a chance de gravar
         * `whatsapp` de outra pessoa e sequestrar a deduplicação dela.
         *
         * O dono edita pelo painel, que também passa por function — a tela nunca
         * escreve direto, pelo mesmo motivo de `bookings`. */
        allow write: if false;
      }

      /* -------- agenda -------- */

      /* Desconto no fechamento — pedido do dono em 28/09.
       *
       * Os campos só entram JUNTO com a conclusão (a chamada vem de dentro do
       * ramo `completed`) e só pelo DONO: o barbeiro concluía em nome próprio
       * antes desta regra existir, e desconto é dinheiro da casa. Sem tocar em
       * campo de desconto, nada aqui é exigido — a conclusão de sempre passa
       * igual.
       *
       * O que a regra garante, porque o gatilho financeiro confia no documento:
       * - 0 ≤ discountAmount ≤ value (decisão 4: sem teto, mas nunca acima do
       *   valor). O servidor limita de novo; esta é a primeira camada;
       * - autoria: `discountBy` é quem grava e `discountAt` é o relógio do
       *   servidor — não dá para atribuir o desconto a outra pessoa nem datá-lo;
       * - desconto parcial exige forma de pagamento, e 100% (cortesia) exige
       *   NENHUMA. É o que separa a cortesia do caminho do mensalista, que
       *   também conclui sem forma — ver `functions/src/desconto.ts`. */
      function descontoDoFechamentoValido(barbershopId) {
        let depois = request.resource.data;
        let mexeu = depois.diff(resource.data).affectedKeys()
          .hasAny(['discountAmount', 'discountInput', 'discountReason', 'discountBy', 'discountAt']);
        return !mexeu || (
          isOwnerOf(barbershopId)
          && depois.keys().hasAll(['discountAmount', 'discountInput', 'discountBy', 'discountAt'])
          && depois.discountAmount is number
          && depois.discountAmount >= 0
          && depois.discountAmount <= resource.data.value
          && depois.discountInput is map
          && depois.discountInput.keys().hasOnly(['tipo', 'valor'])
          && depois.discountInput.tipo in ['valor', 'pct']
          && depois.discountInput.valor is number
          && depois.discountInput.valor >= 0
          && (depois.discountInput.tipo != 'pct' || depois.discountInput.valor <= 100)
          && depois.get('discountReason', null)
               in [null, 'primeira_vez', 'fidelidade', 'amigo_familia', 'cortesia', 'outro']
          && depois.discountBy == request.auth.uid
          && depois.discountAt == request.time
          && (
            depois.discountAmount == 0
            || (depois.discountAmount >= resource.data.value
                && depois.get('paymentMethod', null) == null)
            || (depois.discountAmount < resource.data.value
                && depois.get('paymentMethod', null) != null)
          )
        );
      }

      /* Caixinha (gorjeta) no fechamento — pedido do dono.
       *
       * `tipAmount` entra JUNTO com a conclusão, em reais, e o gatilho
       * financeiro a materializa como pagamento e comissão de 100% do barbeiro.
       * A regra garante o que o gatilho confia no documento:
       * - número > 0 e até o teto (R$ 1.000,00): digitar "1000" no lugar de
       *   "10,00" não vira repasse de milhares;
       * - só com forma de pagamento escolhida: cortesia e "concluir sem cobrar"
       *   do mensalista não receberam dinheiro, logo não têm gorjeta;
       * - qualquer um do time pode informá-la (o modal é o mesmo do barbeiro e do
       *   dono). */
      function caixinhaDoFechamentoValida() {
        let depois = request.resource.data;
        let mexeu = depois.diff(resource.data).affectedKeys().hasAny(['tipAmount']);
        return !mexeu || (
          depois.tipAmount is number
          && depois.tipAmount > 0
          && depois.tipAmount <= 1000
          && depois.get('paymentMethod', null) != null
        );
      }

      /* Concluir e marcar falta só a partir do DIA do atendimento (08/10).
       *
       * O painel do barbeiro mostrava "Concluir" na reserva da semana que vem,
       * e a conclusão materializa pagamento e comissão de um corte que não
       * aconteceu. A tela agora espera o horário; esta é a camada que não
       * depende dela. A regra compara só o DIA (no fuso de São Paulo, UTC−3,
       * sem horário de verão desde 2019): a hora fica com a tela, que sabe a
       * tolerância.
       *
       * `date` é `AAAA-MM-DD`, gravado pelo servidor. Reserva sem `date`
       * (anterior ao campo) não tem dia a conferir e segue a regra de sempre. */
      function diaDoAtendimentoChegou(dados) {
        return !('date' in dados)
          || timestamp.date(int(dados.date.split('-')[0]),
                            int(dados.date.split('-')[1]),
                            int(dados.date.split('-')[2]))
             <= request.time - duration.value(3, 'h');
      }

      match /bookings/{bookingId} {
        allow read: if isOwnerOf(barbershopId)
                    || ehDaMinhaCadeira(barbershopId, resource.data)
                    || (isSignedIn() && resource.data.clientId == request.auth.uid);

        /* Criar reserva é SÓ pela Cloud Function `createBooking`.
         *
         * Esta regra permitia o cliente gravar direto, desde que não mexesse em
         * status e valor. Era o que existia antes de o servidor criar reservas —
         * e ficou aberta depois. Duas coisas passavam por ela:
         *
         * 1. Reserva sem `status`, que não bloqueia horário na checagem de
         *    conflito e mesmo assim aparece na agenda do dono.
         * 2. Criação em massa, sem passar pelo limite por cliente nem pela
         *    validação de dia, horário e antecedência.
         *
         * Nenhuma tela grava reserva direto: o app inteiro chama a função. */
        allow create: if false;

        // Cancelar e reagendar passam por Cloud Function: aplicam a política,
        // calculam o reembolso e registram a ocorrência.
        //
        /* O painel grava direto só DUAS coisas: fechar o atendimento (status +
         * meio e forma de pagamento, na mesma escrita) e marcar falta. Nada
         * além disso.
         *
         * A regra era `update, delete: if isStaffOf` — sem campo nenhum
         * conferido. O gatilho financeiro confia em `cicloFinanceiro`,
         * `cobertura`, `staffId` e `value` do documento, então um barbeiro
         * concluía a reserva de um colega em nome próprio com 100% de comissão
         * sobre R$ 99.999, marcava "coberto por plano" para o dinheiro sumir do
         * caixa, trocava o `clientId` para outra conta ler nome e telefone, ou
         * apagava a reserva deixando pagamento órfão. O dono tinha o mesmo
         * poder, e "financeiro escrito só pelo servidor" não valia (rodada E2E
         * de 23/09, provado com teste de regra).
         *
         * Transição só a partir de reserva em aberto: reabrir um atendimento
         * concluído mexe em dinheiro congelado e é do servidor. */
        allow update: if (isOwnerOf(barbershopId) || ehDaMinhaCadeira(barbershopId, resource.data))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'paymentMethod', 'paymentFormId', 'paymentFormLabel',
                         'discountAmount', 'discountInput', 'discountReason',
                         'discountBy', 'discountAt', 'tipAmount'])
          && diaDoAtendimentoChegou(resource.data)
          && (resource.data.status in ['pending_payment', 'confirmed', 'confirmed_by_client', 'fit_in_requested']
              /* "Veio depois" (02/10): a falta pode virar atendimento concluído
               * — e SÓ concluído, pelo mesmo ramo com método e desconto
               * validados. O gatilho financeiro materializa no_show → completed. */
              || (resource.data.status == 'no_show' && request.resource.data.status == 'completed'))
          && (
            (request.resource.data.status == 'completed'
              && request.resource.data.get('paymentMethod', null) in [null, 'pix', 'cash', 'debit', 'credit']
              && descontoDoFechamentoValido(barbershopId)
              && caixinhaDoFechamentoValida())
            || (request.resource.data.status == 'no_show'
              && !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['paymentMethod', 'paymentFormId', 'paymentFormLabel',
                             'discountAmount', 'discountInput', 'discountReason',
                             'discountBy', 'discountAt', 'tipAmount']))
          );
        /* Histórico não se apaga: reserva errada se cancela. */
        allow delete: if false;
      }

      match /schedules/{scheduleId} {
        allow read: if true;
        allow write: if isOwnerOf(barbershopId);
      }

      /* -------- financeiro: só quem é do time -------- */

      match /expenses/{expenseId}         { allow read, write: if isOwnerOf(barbershopId); }
      /* Livro caixa — escrito SÓ pelo servidor desde a Rodada 3.1 (D25).
       *
       * Era `write: if isOwnerOf`, herdado de quando a coleção não tinha
       * contrato nem uma única escrita. Com valor congelado, sinal derivado do
       * tipo e idempotência por chave, deixar a tela gravar direto tornaria as
       * três promessas falsas na primeira gravação que passasse por fora de
       * `registrarMovimentoDeCaixa`.
       *
       * Mesma decisão de `payments`, `commissions`, `refunds` e
       * `inventory_movements`. `expenses` continua aberta — é o D24, dívida
       * consciente e registrada. */
      match /cash_entries/{entryId}       { allow read: if isOwnerOf(barbershopId);
                                            allow write: if false; }
      /* Comissão é da PESSOA, não da equipe.
       *
       * A regra anterior era `isStaffOf`, ou seja: qualquer barbeiro lia a
       * comissão de todos os colegas. Com uma cadeira só isso nunca apareceu —
       * o único `staff` era o dono. Com equipe, é vazamento de salário entre
       * colegas, que é o tipo de coisa que destrói uma barbearia por dentro.
       *
       * O dono lê tudo, porque é ele quem paga. Cada barbeiro lê o que é dele.
       * O vínculo é por `uid` gravado no documento pelo servidor. */
      match /commissions/{commissionId} {
        allow read: if isOwnerOf(barbershopId)
                    || (souBarbeiroAtivo(barbershopId) && resource.data.uid == request.auth.uid)
                    || ehDaMinhaCadeira(barbershopId, resource.data);
        allow write: if false;
      }
      /* Estoque: LÊ quem toca a loja, ESCREVE só o servidor — G1.
       *
       * Era `read, write: if isStaffOf(...)`, e ficou assim enquanto a coleção
       * não era escrita por ninguém. A partir do momento em que existe
       * `registrarVendaDeProduto`, deixar a escrita aberta reabre tudo que a
       * transação protege:
       *
       * 1. baixar estoque sem registrar a venda, ou registrar a venda sem
       *    baixar estoque — as duas metades do fato deixam de ser atômicas;
       * 2. gravar `unitCost` escolhido a dedo, que é escrever o CMV na mão;
       * 3. furar a checagem de estoque e vender o que não existe;
       * 4. duas vendas simultâneas consumindo a mesma unidade.
       *
       * Mesmo desenho de `bookings` e `payments`: o fato econômico nasce no
       * servidor ou não nasce. */
      match /inventory_movements/{moveId} {
        allow read: if isOwnerOf(barbershopId);
        allow write: if false;
      }

      /* -------- escrita exclusiva do servidor -------- */

      // Dinheiro, assinatura, fidelidade e auditoria só são gravados por Cloud
      // Functions (Admin SDK, que ignora estas regras). O cliente no máximo lê
      // o que é dele.
      function ownsResource() {
        return isSignedIn() && resource.data.clientId == request.auth.uid;
      }

      /* Só o dono lê (09/10). O cliente lia o próprio pagamento, e com ele a
       * taxa da maquininha e o líquido da casa (`feePct`, `feeAmount`,
       * `netAmount`) — dado interno. O que o cliente vê do que pagou é o
       * valor da própria reserva. */
      match /payments/{paymentId} {
        allow read: if isOwnerOf(barbershopId);
        allow write: if false;
      }
      match /refunds/{refundId} {
        allow read: if isOwnerOf(barbershopId) || ownsResource();
        allow write: if false;
      }
      /* O barbeiro NÃO lê (08/10). Lia a coleção inteira para saber, no
       * fechamento, se o cliente é mensalista — e com ela o preço, o
       * vencimento e o horário fixo de todo mensalista da casa, que é receita
       * da barbearia. O fechamento dele pergunta à callable
       * `planoDoAtendimento`: só da cadeira dele, e só nome e cobertura. */
      match /subscriptions/{subscriptionId} {
        allow read: if isOwnerOf(barbershopId) || ownsResource();
        allow write: if false;
      }
      /* Semanas do horário fixo que a rotina não conseguiu reservar (dia
       * fechado, horário ocupado). Só o servidor escreve; a equipe lê para
       * resolver. */
      match /conflitos_horario_fixo/{conflitoId} {
        allow read: if isOwnerOf(barbershopId);
        allow write: if false;
      }

      /* Plano escolhido e pedido de cancelamento (`escolherPlano`,
       * `pedirCancelamento`). O dono lê para a tela dizer "pedido enviado";
       * só a função grava, junto com o aviso ao Hub. */
      match /pedidos_plataforma/{pedidoId} {
        allow read: if isOwnerOf(barbershopId);
        allow write: if false;
      }
      /* Quem recebe os avisos no Telegram. O dono lê para a tela; quem liga e
       * desliga é o servidor (convite e webhook). */
      match /telegram_contatos/{chatId} {
        allow read: if isOwnerOf(barbershopId);
        allow write: if false;
      }
      /* Aparelhos que recebem notificação do app (01/10). O token é um
       * endereço de entrega: legível, outro membro da equipe mandaria
       * notificação falsa para o celular do dono. Só o servidor. */
      match /push_tokens/{aparelhoId} {
        allow read, write: if false;
      }
      match /subscription_invoices/{invoiceId} {
        allow read: if isOwnerOf(barbershopId) || ownsResource();
        allow write: if false;
      }
      match /loyalty_transactions/{txId} {
        allow read: if isOwnerOf(barbershopId) || ownsResource();
        allow write: if false;
      }
      match /client_occurrences/{occurrenceId} {
        allow read: if isOwnerOf(barbershopId);
        allow write: if false;
      }
      match /whatsapp_messages/{messageId} {
        allow read: if isOwnerOf(barbershopId);
        allow write: if false;
      }
      match /audit_log/{entryId} {
        // Log de auditoria é imutável, inclusive para o dono.
        allow read: if isOwnerOf(barbershopId) || isPlatformAdmin();
        allow write: if false;
      }

      /* -------- fallback dentro da barbearia -------- */

      // Coleção nova ainda não declarada acima fica inacessível, em vez de
      // herdar permissão por descuido.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    /* ------------------------------------------------------------------ */
    /* Índice público de barbearias — resolve o subdomínio para o tenant   */
    /* ------------------------------------------------------------------ */

    match /slugs/{slug} {
      // Precisa ser legível sem login: é o que traduz "osiqueira.dominio.com"
      // em um barbershopId antes de qualquer autenticação. Só por `get`:
      // listar o índice é enumerar a base de clientes da plataforma.
      allow get: if true;
      allow list: if isPlatformAdmin();
      allow write: if isPlatformAdmin();
    }

    /* ------------------------------------------------------------------ */
    /* Fallback global                                                     */
    /* ------------------------------------------------------------------ */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
